{
  "name": "@openvaultdb/inprocess",
  "version": "0.1.0",
  "description": "In-process OpenVaultDB server exposed as a standard fetch over local DALgo databases",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "lint": "eslint .",
    "prepack": "pnpm run build",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openvaultdb/openvaultdb-ts.git",
    "directory": "packages/inprocess"
  },
  "bugs": {
    "url": "https://github.com/openvaultdb/openvaultdb-ts/issues"
  },
  "homepage": "https://github.com/openvaultdb/openvaultdb-ts/tree/main/packages/inprocess#readme",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@dalgo/core": ">=0.7.4 <0.9.0"
  },
  "dependencies": {
    "yaml": "2.8.2"
  },
  "devDependencies": {
    "@dalgo/core": "0.8.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1",
    "@openvaultdb/client": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
